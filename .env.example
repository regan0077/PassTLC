# Database
# SQLite file path (created automatically)
DATABASE_FILE="./data/passtlc.db"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PRICE_ID="price_xxx"          # $20/month recurring price
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# App
# MUST be the live origin in production. This file used to default to
# http://localhost:3000, and a .env copied from it put localhost into every
# password-reset link. For local development only, change it to
# http://localhost:3000 in your own .env — never on the server.
NEXT_PUBLIC_SITE_URL="https://passtlc.com"
NEXT_PUBLIC_SITE_NAME="PassTLC"

# Seeded admin account (change password after first login)
ADMIN_EMAIL="admin@passtlc.com"
ADMIN_PASSWORD="PassTLC-Admin!2026"

# ---------------------------------------------------------------------
# SEO / Analytics (all optional — every feature degrades safely if unset)
# ---------------------------------------------------------------------

# Google Analytics 4. Leave blank in development so local traffic never
# reaches the production property; GoogleAnalytics.tsx renders nothing
# without it.
NEXT_PUBLIC_GA_ID=""                       # e.g. G-XXXXXXXXXX

# Search Console / Bing verification. Use the "HTML tag" method and paste
# ONLY the content value, not the whole <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
NEXT_PUBLIC_YANDEX_VERIFICATION=""

# Optional: X/Twitter handle for twitter:site and twitter:creator.
NEXT_PUBLIC_TWITTER_HANDLE=""              # e.g. @passtlc

# IMPORTANT: NEXT_PUBLIC_SITE_URL must be the real production origin with
# no trailing slash. Canonical URLs, hreflang, the sitemap, robots.txt and
# OG image URLs are all derived from it — if it is wrong or left at
# localhost in production, Google will be told to index localhost.

# Where payment screenshots are stored. Defaults to an "uploads" directory
# next to DATABASE_FILE. Must be OUTSIDE the deploy tree on Hostinger.
UPLOAD_DIR=

# Encrypts payment, SMTP and Google credentials stored in the database.
# Falls back to JWT_SECRET if unset. Changing it makes stored secrets
# unreadable and they must be re-entered.
SETTINGS_ENCRYPTION_KEY=
